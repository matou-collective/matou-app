# Root harness pnpm config (factory onboarding, #572 — matches
# Matou/ourcloud's ADR 0040 root convention).
#
# confirm-modules-purge=false: pnpm 11's verify-deps-before-run prompts for
# confirmation before purging a drifted node_modules; under Sandcastle/CI's
# no-TTY harness that prompt aborts the install instead of proceeding
# (ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY). Disabling the confirmation
# lets pnpm proceed (or fail loudly on the real error) instead of stalling.
confirm-modules-purge=false
