<?xml version="1.0" encoding="utf-8"?>
<!-- Backup / transfer rules for Android 12+ (API 31+), referenced from
     AndroidManifest.xml (#545). allowBackup="false" already stops Auto Backup
     and cloud restore on every API level; these rules additionally exclude
     every data domain from device-to-device transfer, which allowBackup does
     NOT govern on Android 12+. The embedded backend's data dir
     (getFilesDir()/matou) and the Keystore-backed secure-prefs must never leave
     the device: the key bundles and peer.key are plaintext, and the identity
     encryption key is Keystore-bound and does not survive a restore. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
