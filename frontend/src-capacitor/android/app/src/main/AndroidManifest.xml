<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Google Auto Backup is disabled (#545). The embedded backend's data dir
         (getFilesDir()/matou, see MatouBackendRunner) holds the any-sync space
         stores, peer.key, the per-space key bundles and identity.json, plus the
         Keystore-backed secure-prefs files (matou_backend_secure, matou_secure).
         With allowBackup="true" and no backup rules that plaintext key material
         was eligible to upload to the user's Google account, and a restore lands
         an undecryptable, half-configured identity (the Keystore master key does
         not survive uninstall). This is device-bound state, so nothing here
         should ride platform backup; mirrors the iOS shell's isExcludedFromBackup
         on the same dir. allowBackup="false" stops Auto Backup / cloud restore on
         all API levels; dataExtractionRules additionally excludes every domain
         from the Android 12+ device-to-device transfer that allowBackup alone
         does not cover. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Wallet sign-in link scheme (#532, idss #1492 story 34). Opening a
                 matou:// link — the sign-in page's "Open my community app" button
                 and its QR carry matou://signin, and the linked-device pairing
                 link is matou://pair — launches the app; because MainActivity is
                 singleTask the URL arrives via onNewIntent, which the
                 @capacitor/app plugin surfaces as appUrlOpen for the WebView's
                 deep-link handler to route (approve card / link-device screen). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="matou" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Push notifications (#177) — content-free FCM wake signals; see
             docs/architecture/08-push-notifications.md. These FCM defaults are
             used if a `notification`-block message ever arrives; our own
             payloads are data-only (§4) and post local notifications instead. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_matou" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/matou_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="matou_dm" />

        <!-- Matou's FCM entry point (§5). Extends the Capacitor plugin's service
             so JS delivery is unchanged; it is the hook for the background
             sync-only wake. Registering ours means we drop the plugin's default
             service so exactly one FirebaseMessagingService handles the event. -->
        <service
            android:name=".MatouMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />

        <!-- Headless push wake (#421, §5): below Android 12 WorkManager runs
             expedited work as a short foreground service; targetSdk 34+ requires
             its type declared. dataSync matches what the wake does — sync one
             chat channel over the embedded backend. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Linked-device sign-in (#473): the in-app barcode scanner fallback
         (@capacitor-mlkit/barcode-scanning startScan()) needs the camera on
         devices without Google Play Services. The preferred Google Code Scanner
         path (scan()) needs NO camera permission, so this is only requested at
         tap time when we fall back. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android 13+ runtime notification permission (requested after onboarding, §7). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Headless push wake (#421): pre-Android-12 expedited WorkManager work is
         a foreground service; API 34+ additionally requires the typed permission
         matching the dataSync type declared on SystemForegroundService above. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
</manifest>
