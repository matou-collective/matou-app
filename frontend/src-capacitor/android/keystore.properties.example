# Copy to keystore.properties (git-ignored) for local signed release builds.
# Relative paths resolve against frontend/src-capacitor/android/.
# See docs/mobile/PLAY_STORE.md for how the upload keystore is generated and stored.
storeFile=/home/you/.matou-secrets/matou-upload.jks
storePassword=CHANGE_ME
keyAlias=matou-upload
keyPassword=CHANGE_ME
