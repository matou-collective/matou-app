# MATOU Frontend — matou-dev environment
#
# Runs the same "production-shaped" discovery path as .env.production.example
# (VITE_ENV=prod — the app just asks one config server for everything), but
# points it at the shared matou-dev deployment (matou-distributed-servers-dev)
# instead of local Docker infra or real production. No app code change
# needed: config-server is the single knob everything else (KERIA,
# witnesses, schema-server, any-sync) is discovered from.
#
# Named template, not auto-loaded — same idiom as .env.example/.env.production.example:
#
#   To run `npm run dev` against matou-dev (Vite loads .env/.env.local
#   regardless of mode — same as .env.example's own instruction):
#     cp .env.matou-dev .env.local && npm run dev
#
#   To additionally BUILD an Electron release pointed at matou-dev
#   (quasar.config.ts reads the literal filename .env.production for
#   Electron main-process env injection — a separate mechanism):
#     cp .env.matou-dev .env.production && npm run build
#   (swap back to a real .env.production before ever building a real release)
#
# Backend still runs locally — point it at the same config server with:
#   MATOU_ENV=production MATOU_CONFIG_SERVER_URL=https://config.dev.matou.nz make run
# (or `make run-matou-dev` from backend/, once matou-dev-server-01 is live).

VITE_ENV=prod

# Config server URLs — only VITE_PROD_CONFIG_URL matters for this file, but
# keep dev/test defaults so `VITE_ENV` can be flipped locally without
# swapping .env files.
VITE_DEV_CONFIG_URL=http://localhost:3904
VITE_TEST_CONFIG_URL=http://localhost:4904
VITE_PROD_CONFIG_URL=https://config.dev.matou.nz

# Backend API URL — the matou-app backend still runs on your machine,
# pointed at matou-dev infra via MATOU_CONFIG_SERVER_URL (see above).
VITE_BACKEND_URL=http://localhost:8080
