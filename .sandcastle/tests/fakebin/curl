#!/usr/bin/env bash
# Fake curl for ask-human.sh / resume-parked-asks.sh tests. Routes Mattermost
# and Forgejo API calls to canned JSON under $FAKE_DIR; records created
# Mattermost posts in $FAKE_DIR/posts.log, Forgejo write bodies in
# $FAKE_DIR/forgejo.log, and every call as "METHOD URL" in $FAKE_DIR/calls.log.
set -eu
url="" data="" method=GET
while [ $# -gt 0 ]; do
  case "$1" in
    -X)
      method="$2"
      shift 2
      ;;
    -H | -d)
      [ "$1" = -d ] && data="$2"
      shift 2
      ;;
    -*) shift ;;
    *)
      url="$1"
      shift
      ;;
  esac
done
if [ "$data" = "@-" ]; then body="$(cat)"; else body="$data"; fi
[ -n "$body" ] && [ "$method" = GET ] && method=POST
printf '%s %s\n' "$method" "$url" >>"$FAKE_DIR/calls.log"
case "$url" in
  */users/me) echo '{"id":"BOTID"}' ;;
  */api/v4/posts)
    n="$(cat "$FAKE_DIR/counter" 2>/dev/null || echo 0)"
    n=$((n + 1))
    echo "$n" >"$FAKE_DIR/counter"
    printf '%s\n' "$body" >>"$FAKE_DIR/posts.log"
    echo "{\"id\":\"NEWQ$n\"}"
    ;;
  */channels/*/posts*)
    cat "$FAKE_DIR/channel.json" 2>/dev/null || echo '{"posts":{},"order":[]}'
    ;;
  */posts/*/thread)
    id="${url#*/api/v4/posts/}"
    id="${id%/thread}"
    cat "$FAKE_DIR/thread-$id.json" 2>/dev/null || echo '{"posts":{}}'
    ;;
  */issues/*/comments)
    printf '%s\n' "$body" >>"$FAKE_DIR/forgejo.log"
    echo '{}'
    ;;
  */issues/*/labels/*)
    echo ''
    ;;
  */issues/*/labels)
    printf '%s\n' "$body" >>"$FAKE_DIR/forgejo.log"
    echo '[]'
    ;;
  */issues\?*)
    cat "$FAKE_DIR/issues.json" 2>/dev/null || echo '[]'
    ;;
  */repos/*/labels*)
    cat "$FAKE_DIR/labels.json" 2>/dev/null || echo '[]'
    ;;
  *)
    echo "fake curl: unhandled url $url" >&2
    exit 22
    ;;
esac
