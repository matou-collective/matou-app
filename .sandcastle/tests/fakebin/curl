#!/usr/bin/env bash
# Fake curl for ask-human.sh / resume-parked-asks.sh tests. Routes Mattermost
# and Forgejo API calls to canned JSON under $FAKE_DIR; records created
# Mattermost posts in $FAKE_DIR/posts.log, Forgejo write bodies in
# $FAKE_DIR/forgejo.log, every call as "METHOD URL" in $FAKE_DIR/calls.log, and
# the WHOLE argv of every call in $FAKE_DIR/argv.log (one line per call) — the
# seam that lets a test assert a caller's timeout flag (#28) rather than only
# the URL it asked for.
set -eu
printf '%s\n' "$*" >>"$FAKE_DIR/argv.log"
url="" data="" method=GET want_code=
while [ $# -gt 0 ]; do
  case "$1" in
    -X)
      method="$2"
      shift 2
      ;;
    -m | --max-time)
      # Value-carrying, so consume BOTH tokens: the generic `-*) shift` arm
      # below would leave the bare number to be read as the URL.
      shift 2
      ;;
    -w)   # `-w '%{http_code}'` — caller wants the HTTP status, not the body
      want_code=1
      shift 2
      ;;
    -o)   # `-o /dev/null` — discard body (its value is a filename, consume it)
      shift 2
      ;;
    -H | -d)
      [ "$1" = -d ] && data="$2"
      shift 2
      ;;
    -*) shift ;;
    *)
      url="$1"
      shift
      ;;
  esac
done
if [ "$data" = "@-" ]; then body="$(cat)"; else body="$data"; fi
[ -n "$body" ] && [ "$method" = GET ] && method=POST
printf '%s %s\n' "$method" "$url" >>"$FAKE_DIR/calls.log"
# Hang seam (#28): $FAKE_DIR/api-timeout makes every call answer the way a real
# `curl --max-time N` answers a server that never replies — rc 28, no body, and
# `000` for a caller using the -w '%{http_code}' idiom. A caller with NO timeout
# would instead block forever, which a test cannot express; the ratchet that no
# harness API reader ships without one lives in actions-endpoint-test.sh.
if [ -f "$FAKE_DIR/api-timeout" ]; then
  [ -n "$want_code" ] && echo 000
  exit 28
fi
case "$url" in
  */users/me) echo '{"id":"BOTID"}' ;;
  */api/v4/posts)
    n="$(cat "$FAKE_DIR/counter" 2>/dev/null || echo 0)"
    n=$((n + 1))
    echo "$n" >"$FAKE_DIR/counter"
    printf '%s\n' "$body" >>"$FAKE_DIR/posts.log"
    echo "{\"id\":\"NEWQ$n\",\"create_at\":$(date +%s%3N)}"
    ;;
  */channels/*/posts*)
    cat "$FAKE_DIR/channel.json" 2>/dev/null || echo '{"posts":{},"order":[]}'
    ;;
  */posts/*/thread)
    id="${url#*/api/v4/posts/}"
    id="${id%/thread}"
    cat "$FAKE_DIR/thread-$id.json" 2>/dev/null || echo '{"posts":{}}'
    ;;
  */actions/tasks*)
    # Concurrency seam (#120): stamp the nanosecond this fetch was made so a
    # test can prove claim_alive_runs runs CONCURRENTLY with the lister (its
    # stamp precedes a deliberately-slow lister's finish) rather than serially
    # after it.
    [ -f "$FAKE_DIR/stamp-tasks" ] && date +%s%N >"$FAKE_DIR/tasks-hit.stamp"
    # Review-finding-1 repro seam: presence of this flag file simulates the
    # tasks API being down (curl -sf's own real failure mode), independent of
    # the JSON fixture below — used to prove claim_alive_runs/janitor_sweep
    # fail loud instead of silently degrading to an empty "nothing alive".
    [ -f "$FAKE_DIR/tasks-fail" ] && exit 22
    cat "$FAKE_DIR/tasks.json" 2>/dev/null || echo '{"workflow_runs":[]}'
    ;;
  */issues\?*labels=agent-working*)
    # Paged: page N looks for issues-agent-working-page<N>.json first; page 1
    # falls back to the unsuffixed fixture (existing single-page tests keep
    # working unchanged), any other page with no override is an empty page
    # (so a test that doesn't care about paging can't accidentally loop).
    page="${url##*page=}"; page="${page%%&*}"
    if [ -f "$FAKE_DIR/issues-agent-working-page$page.json" ]; then
      cat "$FAKE_DIR/issues-agent-working-page$page.json"
    elif [ "$page" = "1" ]; then
      cat "$FAKE_DIR/issues-agent-working.json" 2>/dev/null || echo '[]'
    else
      echo '[]'
    fi
    ;;
  */pulls\?state=open*)   # open PR set (LANDING=pr, #13) — client filters by head.ref
    cat "$FAKE_DIR/open-pulls.json" 2>/dev/null || echo '[]'
    ;;
  */pulls\?state=closed*) # closed PR set (#108) — client filters by head.ref + .merged
    cat "$FAKE_DIR/closed-pulls.json" 2>/dev/null || echo '[]'
    ;;
  */pulls/*/merge)        # merge a PR; its `closes #N` closes the mapped issue
    printf '%s\n' "$body" >>"$FAKE_DIR/forgejo.log"
    prn="${url%/merge}"; prn="${prn##*/}"
    [ -f "$FAKE_DIR/pr-$prn-closes" ] && touch "$FAKE_DIR/closed-$(cat "$FAKE_DIR/pr-$prn-closes")"
    if [ -n "$want_code" ]; then cat "$FAKE_DIR/merge-code" 2>/dev/null || echo 200; else echo '{}'; fi
    ;;
  */commits/*/status*)    # combined CI status for a commit (merge-if-green, #15)
    cat "$FAKE_DIR/commit-status.json" 2>/dev/null || echo '{"state":"success","statuses":[]}'
    ;;
  */pulls/[0-9]*)         # GET a single PR — head.sha + html_url
    prn="${url##*/}"
    cat "$FAKE_DIR/pr-$prn.json" 2>/dev/null || echo '{"number":'"$prn"',"head":{"ref":"agent/issue-444"},"html_url":"u/pr/'"$prn"'"}'
    ;;
  */issues/comments/*)   # DELETE a claim comment (repo-level endpoint)
    cid="${url##*/}"
    for f in "$FAKE_DIR"/comments-*.json; do
      [ -f "$f" ] || continue
      jq --argjson id "$cid" '[.[] | select(.id != $id)]' "$f" >"$f.tmp" && mv "$f.tmp" "$f"
    done
    ;;
  */issues/*/comments)
    if [ "$method" = GET ]; then
      id="${url%/comments}"
      id="${id##*/}"
      cat "$FAKE_DIR/comments-$id.json" 2>/dev/null || echo '[]'
    else
      printf '%s\n' "$body" >>"$FAKE_DIR/forgejo.log"
      if printf '%s' "$body" | jq -r .body 2>/dev/null | grep -q '^swarm-claim '; then
        n="$(cat "$FAKE_DIR/comment-counter" 2>/dev/null || echo 1000)"; n=$((n + 1))
        echo "$n" >"$FAKE_DIR/comment-counter"
        num="${url%/comments}"; num="${num##*/}"
        existing="$(cat "$FAKE_DIR/comments-$num.json" 2>/dev/null || echo '[]')"
        jq --argjson id "$n" --arg b "$(printf '%s' "$body" | jq -r .body)" \
          '. + [{id:$id, body:$b}]' <<<"$existing" >"$FAKE_DIR/comments-$num.json"
        echo "{\"id\":$n}"
      else
        echo '{}'
      fi
    fi
    ;;
  */issues/*/labels/*)
    # DELETE a single label off an issue (claim release, #22). When the caller
    # asks for the HTTP code (forgejo_remove_label's -w idiom), answer it;
    # $FAKE_DIR/label-delete-fail (containing a code, default 404) simulates a
    # 4xx removal — which must warn but NOT change close-report's exit code.
    if [ -n "$want_code" ]; then
      if [ -f "$FAKE_DIR/label-delete-fail" ]; then
        cat "$FAKE_DIR/label-delete-fail" 2>/dev/null || echo 404
      else
        echo 204
      fi
    else
      echo ''
    fi
    ;;
  */issues/*/labels)
    printf '%s\n' "$body" >>"$FAKE_DIR/forgejo.log"
    # A label write returns an HTTP code when the caller asked with -w (the
    # claim_mark_working / forgejo_add_labels idiom). $FAKE_DIR/labels-post-fail
    # (containing a code, default 403) simulates the bot lacking repo.issues
    # write — the #20 seam that let #19 be worked with no agent-working label.
    if [ -n "$want_code" ]; then
      if [ -f "$FAKE_DIR/labels-post-fail" ]; then
        cat "$FAKE_DIR/labels-post-fail" 2>/dev/null || echo 403
      else
        echo 201
      fi
    else
      echo '[]'
    fi
    ;;
  */issues/[0-9]*)
    id="${url##*/}"
    if [ "$method" = GET ]; then
      # After a successful close PATCH the issue reads `closed` (close-report.sh
      # GETs to VERIFY the close stuck — #20). A fixture wins if provided.
      if [ -f "$FAKE_DIR/issue-$id.json" ]; then
        cat "$FAKE_DIR/issue-$id.json"
      elif [ -f "$FAKE_DIR/closed-$id" ]; then
        echo '{"state":"closed"}'
      else
        echo '{"state":"open"}'
      fi
    else
      # Single-issue write, e.g. PATCH .../issues/9 {"state":"closed"}.
      printf '%s\n' "$body" >>"$FAKE_DIR/forgejo.log"
      # $FAKE_DIR/close-fail (containing a code, default 403) simulates the bot
      # lacking repo.issues write: the close PATCH is refused and the issue does
      # NOT flip to closed (#20 — the gap that made #19 look like four closes).
      if printf '%s' "$body" | grep -q '"state":"closed"'; then
        if [ -f "$FAKE_DIR/close-fail" ]; then
          [ -n "$want_code" ] && { cat "$FAKE_DIR/close-fail" 2>/dev/null || echo 403; }
        else
          touch "$FAKE_DIR/closed-$id"
          [ -n "$want_code" ] && echo 200
        fi
      else
        [ -n "$want_code" ] && echo 200
      fi
      [ -z "$want_code" ] && echo '{}'
    fi
    ;;
  */issues\?*)
    cat "$FAKE_DIR/issues.json" 2>/dev/null || echo '[]'
    ;;
  */repos/*/labels*)
    cat "$FAKE_DIR/labels.json" 2>/dev/null || echo '[]'
    ;;
  */actions/workflows/*/dispatches)
    printf '%s\n' "$body" >>"$FAKE_DIR/forgejo.log"
    echo '{}'
    ;;
  */api/v1/repos/*)   # bare repo root GET — #15 default_merge_style (all named
                      # sub-resources are matched above, so only the root lands here)
    cat "$FAKE_DIR/repo.json" 2>/dev/null || echo '{"default_merge_style":"merge","permissions":{"push":true}}'
    ;;
  *)
    echo "fake curl: unhandled url $url" >&2
    exit 22
    ;;
esac
